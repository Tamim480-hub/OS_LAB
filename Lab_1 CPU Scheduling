arrival = [3, 2, 5, 0, 1]
burst = [3, 1, 2, 3, 2]

time = 0
total_wt = 0
total_tat = 0

# FCFS order: P4, P5, P2, P1, P3
order = [3, 4, 1, 0, 2]

completion = [0] * 5
turnaround = [0] * 5
waiting = [0] * 5

for i in order:

    if time < arrival[i]:
        time = arrival[i]

    completion[i] = time + burst[i]
    turnaround[i] = completion[i] - arrival[i]
    waiting[i] = turnaround[i] - burst[i]

    total_wt += waiting[i]
    total_tat += turnaround[i]

    time = completion[i]

print("Process\tAT\tBT\tCT\tTAT\tWT")

for i in range(5):
    print("P" + str(i+1), "\t", arrival[i], "\t", burst[i],
          "\t", completion[i], "\t", turnaround[i], "\t", waiting[i])

print("Average Waiting Time:", total_wt / 5)
print("Average Turnaround Time:", total_tat / 5)
