requests = [0, 41, 30, 100, 62, 51, 20]

head = 70
total_seek = 0

left = []
right = []

for r in requests:
    if r < head:
        left.append(r)
    else:
        right.append(r)

left.sort(reverse=True)
right.sort()

sequence = [head] + left + [0] + right

for i in range(len(sequence) - 1):
    total_seek += abs(sequence[i] - sequence[i + 1])

print("Seek Sequence:", sequence)
print("Total Seek:", total_seek)
